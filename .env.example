# Copia questo file in .env e compila. La ANON KEY e' pubblica per design
# (finisce nel bundle JS), ma non si committa: vive nei GitHub Secrets per la
# build di produzione (audit A3).
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# Optional: Enable demo mode even when Supabase is configured
# VITE_DEMO_MODE=true

# Optional: Sentry error monitoring (production builds only; disabled in dev & demo mode)
# VITE_SENTRY_DSN="https://examplePublicKey@o0.ingest.de.sentry.io/0"
# VITE_SENTRY_ENVIRONMENT="production"
# CI-only (do NOT prefix with VITE_): used by @sentry/vite-plugin to upload & delete hidden source maps
# SENTRY_AUTH_TOKEN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""
